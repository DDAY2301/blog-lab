# Free/local-first configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_MANAGER_MODEL=qwen3-coder:30b
AGENT_MANAGER_FALLBACK_MODELS=qwen2.5-coder:7b,devstral

# Windows: separate paths with ;
# Linux/macOS: separate paths with :
AGENT_MANAGER_ROOTS=
AGENT_MANAGER_MAX_FILES=4000
AGENT_MANAGER_MAX_FILE_BYTES=300000
AGENT_MANAGER_STATE=

# Autonomous write mode is intentionally opt-in.
# start-autopilot.ps1 enables it for the trusted local process.
AGENT_MANAGER_WRITE_ENABLED=0

# Optional GitHub fine-grained PAT for a headless server.
# Prefer GitHub CLI login on a personal PC. Never commit the real token.
AGENT_MANAGER_GITHUB_TOKEN=
