{
  "name": "blog-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run art:generate && vite",
    "build": "node scripts/verify-atomic-articles-v4.mjs && npm run art:generate && npm run art:check && vite build",
    "preview": "vite preview",
    "guardian:check": "python agents/production-guardian/guardian.py check --report logs/guardian-report.json",
    "guardian:repair": "python agents/production-guardian/guardian.py repair",
    "test:guardian": "python -m pytest -q agents/production-guardian/tests",
    "art:generate": "node tools/generate-painted-assets.mjs",
    "art:check": "node tools/verify-atelier-v5.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "jose": "^6.2.12",
    "vite": "^8.0.13",
    "typescript": "^5.9.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {}
}
