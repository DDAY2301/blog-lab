{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-lab",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["7,22,37,52 * * * *"] },
  "observability": { "enabled": true }
}
