{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-lab",
  "main": "terminal/worker/src/index.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
